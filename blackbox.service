[Unit]
Description=Vehicle Black Box — Flask Dashboard + Sensor Logging
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/vehicle-blackbox
ExecStart=/usr/bin/python3 /home/pi/vehicle-blackbox/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
