# ==============================================================================
# Smart Vehicle Black Box - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local settings:
#   cp .env.example .env

# Emergency Contact Phone Number (include international country code)
# Example: +919876543210
EMERGENCY_PHONE=+91XXXXXXXXXX

# Black Box Operating Mode:
#   - FULL     : Both GPS tracking and GSM SMS alerts active
#   - GPS_ONLY : GPS tracking active, GSM disabled (no SIM card required)
#   - GSM_ONLY : GSM alerts active, GPS disabled (free up UART pins 14/15)
BLACKBOX_MODE=GPS_ONLY

# Web Dashboard Port (default: 5000)
PORT=5000
